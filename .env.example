# Copy to .env before running `docker compose up`.

# The URL browsers will use to reach the backend. For a VPS deploy this is
# your server's public IP or domain, e.g. http://203.0.113.10:8000 or
# https://api.yourdomain.com. Baked into the frontend at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Comma-separated list of exact frontend origins allowed to call the API,
# e.g. http://203.0.113.10:3000 or https://narc-trace.vercel.app
# Use * only for local testing.
ALLOWED_ORIGINS=*
